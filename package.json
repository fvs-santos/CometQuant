{
  "name": "cometquant",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "vendor": "node scripts/vendor.js",
    "postinstall": "npm run vendor",
    "test": "vitest run",
    "test:analysis": "python -m unittest discover -s tests/python -p \"test_*.py\"",
    "test:reference:r": "python scripts/validate_reference_with_r.py",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "node --check js/core.js && node --check js/export.js && node --check js/app.js && node --check js/analysis.js && node --check js/i18n.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@vitest/coverage-v8": "^3.2.4",
    "http-server": "^14.1.1",
    "jsdom": "^26.1.0",
    "jszip": "^3.10.1",
    "vitest": "^3.2.4"
  }
}
